# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
# Use Supabase "Session pooler" URI (IPv4). Direct connection (db.*.supabase.co) may fail on networks without IPv6.
# Dashboard: Project Settings → Database → Connection string → Session pooler
DATABASE_URL=

# Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# External APIs
EXERCISEDB_API_KEY=
OPEN_FOOD_FACTS_APP_ID=

# App
NODE_ENV=development
PORT=3333
JWT_SECRET=

# Mobile (apps/mobile/.env)
# Emulador Android: use 10.0.2.2 (alias do localhost do PC)
# Dispositivo físico na mesma rede: use o IP da máquina (ex. http://192.168.0.7:3333)
# Web / iOS simulator: http://localhost:3333
EXPO_PUBLIC_API_URL=http://10.0.2.2:3333
