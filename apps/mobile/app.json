{
  "expo": {
    "name": "IronSynk",
    "slug": "ironsynk",
    "version": "1.0.0",
    "orientation": "portrait",
    "entryPoint": "./index.ts",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141418"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironsynk.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141418"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ironsynk.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite escolher fotos e vídeos para publicar seus treinos.",
          "cameraPermission": "Permite capturar fotos e vídeos para publicar seus treinos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "cb6265b8-4a60-40c9-bdcd-628b1bdd1854"
      }
    }
  }
}
